SERVICE_API_TOKEN=
SERVICE_REDIS_PASSWORD=
SERVICE_HTTP_PORT=8080
SERVICE_REDIS_PORT=16379
SERVICE_PROMETHEUS_PORT=9095
SERVICE_NAMESPACE=agent-service
# Scope: choose a verified version tag for deployment; :local remains a development default.
# 为什么要有它：API、Worker与语料准备必须运行同一可核对版本，不能将浮动开发标签当作已验证部署。
SERVICE_IMAGE=rag-agent-service:local
SERVICE_REDIS_MAXMEMORY=134217728
SERVICE_REQUESTS_PER_MINUTE=120
SERVICE_MAX_PENDING=1000
# Scope: encoded namespace data plus reservations, not Redis memory or RSS.
# 为什么要有它：缓存与任务共享准入预算，运行中任务的额度不能被新请求占用；旧数据不自动迁移或清零。
SERVICE_CAPACITY_BYTES=67108864
SERVICE_CACHE_CAPACITY_BYTES=16777216
SERVICE_MAX_JOB_SECONDS=600
# Scope: worker only; isolated restores one child per attempt. 为什么要有它：保留同配置生命周期回退，不改变API配额或业务结果缓存。
SERVICE_QUERY_EXECUTION_MODE=resident_sparse
